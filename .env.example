# Copy to .env and fill in the API key(s) below. `.env` is gitignored so
# your key is never committed. The bundled examples use the
# experientiallabs.ai OpenAI-compatible endpoint by default (see
# examples/_llm.py) and only require EXPLABS_API_KEY.

# Required for running examples/*.py
EXPLABS_API_KEY=
# Optional overrides (defaults shown)
# EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# EXPLABS_MODEL=gpt-5.6-luna

# Example: OpenAI (only needed if you swap a real OpenAI model in yourself)
OPENAI_API_KEY=

# Example: Anthropic
ANTHROPIC_API_KEY=
