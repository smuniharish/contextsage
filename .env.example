# Configuration for the live examples (examples/live_agent.py, deep_agent.py
# and swarm.py). Copy this file to .env, which git ignores, and fill it in.
# The offline examples need no configuration.

# API key for an OpenAI-compatible chat completions endpoint (required).
CONTEXTSAGE_LLM_API_KEY=

# Base URL ending in /v1 (optional; defaults to OpenAI).
# CONTEXTSAGE_LLM_BASE_URL=https://api.openai.com/v1

# Model name (optional; defaults to gpt-5-mini).
# CONTEXTSAGE_LLM_MODEL=gpt-5-mini
